# Discord webhook the contact form posts to.
# Create one in Discord: Server Settings → Integrations → Webhooks → New Webhook → Copy URL.
#
# NOTE: this is a STATIC site, so whatever URL you put here ships inside the client
# JavaScript bundle and is publicly visible. That's expected for a client-side webhook.
# Casual-bot protection (honeypot + time-trap) is built into the contact form; if the
# webhook is ever abused, just regenerate it in Discord (or front it with a serverless
# proxy later — the UI won't need to change). See app/components/ContactModal.vue.
#
# Leave empty to use the built-in simulated-success fallback (form works, sends nothing).
NUXT_PUBLIC_DISCORD_WEBHOOK_URL=
